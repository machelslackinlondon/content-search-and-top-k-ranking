{
  "name": "content-search-and-top-k-ranking",
  "version": "1.0.0",
  "description": "An educational in-memory content search service with explicit indexing, ranking, Top-K selection, and backpressure.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && jest --config jest.config.cjs",
    "test:coverage": "npm run build:test && jest --config jest.config.cjs --coverage",
    "start": "node dist/server.js",
    "load:seed": "node load-tests/seed.js",
    "load:search": "node load-tests/search.js",
    "load:index": "node load-tests/index.js",
    "load:mixed": "node load-tests/mixed.js",
    "load:large-query": "node load-tests/large-query.js",
    "load:many-candidates": "node load-tests/many-candidates.js",
    "load:bulk": "node load-tests/bulk.js",
    "load:fuzzy": "node load-tests/fuzzy.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.0",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.4",
    "autocannon": "8.0.0",
    "jest": "30.5.2",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
